{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/joshkeldam/databento-stream-downloader/schemas/ledger_schema_v4.json",
  "title": "Databento Stream Downloader Ledger Record v4",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "ledger_schema_version",
    "run_id",
    "dataset",
    "package_version",
    "host",
    "user",
    "mode",
    "deep_validate",
    "strict_validate",
    "validate_cached",
    "started_at",
    "ended_at",
    "symbols",
    "schemas",
    "start",
    "end",
    "placed",
    "cached",
    "no_data",
    "failed",
    "validation_issues",
    "exit_code",
    "interrupted",
    "estimated_cost_cents",
    "estimated_cost_cents_landed",
    "estimated_billable_bytes",
    "estimated_billable_bytes_landed",
    "retry_count_total",
    "retry_count_by_operation",
    "stream_retry_count",
    "stream_attempt_count_estimated",
    "attempts_by_outcome",
    "directory_fsync_skipped_count",
    "elapsed_seconds",
    "universe_sha256",
    "symbols_sha256"
  ],
  "properties": {
    "ledger_schema_version": { "const": 4 },
    "run_id": { "type": "string", "minLength": 1 },
    "dataset": { "type": "string", "minLength": 1 },
    "package_version": { "type": "string", "minLength": 1 },
    "host": { "type": "string" },
    "user": { "type": "string" },
    "mode": { "enum": ["dry_run", "execute"] },
    "deep_validate": { "type": "boolean" },
    "strict_validate": { "type": "boolean" },
    "validate_cached": { "type": "boolean" },
    "started_at": { "type": "string", "format": "date-time" },
    "ended_at": { "type": "string", "format": "date-time" },
    "symbols": { "type": "array", "items": { "type": "string" } },
    "schemas": { "type": "array", "items": { "type": "string" } },
    "start": { "type": "string", "format": "date" },
    "end": { "type": "string", "format": "date" },
    "placed": { "type": "integer", "minimum": 0 },
    "cached": { "type": "integer", "minimum": 0 },
    "no_data": { "type": "integer", "minimum": 0 },
    "failed": { "type": "integer", "minimum": 0 },
    "validation_issues": { "type": "integer", "minimum": 0 },
    "exit_code": { "type": "integer", "minimum": 0 },
    "interrupted": { "type": "boolean" },
    "estimated_cost_cents": { "type": "integer", "minimum": 0 },
    "estimated_cost_cents_landed": { "type": "integer", "minimum": 0 },
    "estimated_billable_bytes": { "type": "integer", "minimum": 0 },
    "estimated_billable_bytes_landed": { "type": "integer", "minimum": 0 },
    "retry_count_total": { "type": "integer", "minimum": 0 },
    "retry_count_by_operation": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "stream_retry_count": { "type": "integer", "minimum": 0 },
    "stream_attempt_count_estimated": { "type": "integer", "minimum": 0 },
    "attempts_by_outcome": {
      "type": "object",
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "directory_fsync_skipped_count": { "type": "integer", "minimum": 0 },
    "elapsed_seconds": { "type": "number", "minimum": 0 },
    "universe_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "symbols_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
